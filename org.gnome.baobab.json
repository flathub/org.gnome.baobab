{
    "id": "org.gnome.baobab",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "baobab",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--filesystem=host",
        "--filesystem=~/.var/app",
        "--metadata=X-DConf=migrate-path=/org/gnome/baobab/",
        "--talk-name=org.gtk.vfs.*",
        "--system-talk-name=org.freedesktop.hostname1",
        "--filesystem=xdg-run/gvfs",
        "--filesystem=xdg-run/gvfsd"
    ],
    "cleanup": [
        "/share/man"
    ],
    "modules": [
        {
            "name": "baobab",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/baobab/50/baobab-50.0.tar.xz",
                    "sha256": "573c84f15f5f963a440500f6f43412c928ac2335f6b69dcb58f1a1fe5201024b",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "baobab"
                    }
                }
            ]
        }
    ]
}
